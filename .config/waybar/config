[
  {
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "height": 40,
    "modules-left": [
      "niri/workspaces",
      "niri/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "disk",
      "cpu",
      "memory",
      "backlight",
      "network",
      "pulseaudio",
      "bluetooth",
      "battery",
      "niri/language",
      "custom/power-menu"
    ],
    "niri/workspaces": {
      "format": "{index}",
      "active-only": false,
      "all-outputs": true
    },
    "niri/window": {
      "max-length": 30
    },
    "disk": {
      "interval": 30,
      "format": "󰋊 {specific_free:0.1f}G",
      "unit": "GB",
      "path": "/"
    },
    "cpu": {
      "interval": 5,
      "format": " {usage}%"
    },
    "memory": {
      "interval": 10,
      "format": " {used:0.1f}G"
    },
    "backlight": {
      "device": "intel_backlight",
      "format": "{icon} {percent}%",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃠"
      ]
    },
    "network": {
      "format-wifi": "<span font='14px' rise='1500'>{icon}</span>",
      "format-ethernet": "<span font='14px' rise='1500'>ETH {ifname}</span>",
      "format-disconnected": "<span font='14px' rise='1500'>󰌙</span>",
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤢",
        "󰤨"
      ],
      "states": {
        "excellent": 80,
        "good": 60,
        "medium": 40,
        "low": 20
      },
      "on-click": "networkmanager_dmenu",
      "tooltip-format-wifi": "Signal Strength: {signalStrength}%",
      "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
      "tooltip": true
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "on-click": "pavucontrol"
    },
    "bluetooth": {
      "format": "",
      "format-connected": "",
      "format-connected-battery": "",
      "format-disabled": "",
      "format-off": "",
      "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
      "on-click": "blueman-manager"
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": " {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "clock": {
      "format": "{:%H:%M  •  %a %d}",
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "niri/language": {
      "format": "{short}"
    },
    "custom/power-menu": {
      "format": "⏻",
      "on-click": "~/.config/waybar/scripts/power-menu.sh"
    }
  }
]
