[
  {
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "height": 40,
    "modules-left": [
      "niri/workspaces",
      "niri/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "disk",
      "cpu",
      "memory",
      "backlight",
      "network",
      "pulseaudio",
      "battery",
      "niri/language",
      "custom/power-menu"
    ],
    "niri/workspaces": {
      "format": "{index}",
      "active-only": false,
      "all-outputs": true
    },
    "niri/window": {
      "max-length": 30
    },
    "disk": {
      "interval": 30,
      "format": "󰋊 {specific_free:0.1f}G",
      "unit": "GB",
      "path": "/"
    },
    "cpu": {
      "interval": 5,
      "format": " {usage}%"
    },
    "memory": {
      "interval": 10,
      "format": " {used:0.1f}G"
    },
    "backlight": {
      "device": "intel_backlight",
      "format": "{icon} {percent}%",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃠"
      ]
    },
    "network": {
      "format-wifi": "{icon}",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰌙",
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤨"
      ],
      "tooltip-format-wifi": "{essid} ({signalStrength}%)",
      "on-click": "alacritty -e nmtui"
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "on-click": "pavucontrol"
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": " {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "clock": {
      "format": "{:%H:%M  •  %a %d}",
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "niri/language": {
      "format": "{short}"
    },
    "custom/power-menu": {
      "format": "⏻",
      "on-click": "~/.config/waybar/scripts/power-menu.sh"
    }
  }
]